# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=sic_admin

# Shared secret the admin panel must send in the "x-admin-secret" header.
# Pick a long random string. Treat it like a password.
ADMIN_SECRET=change_me_to_a_long_random_string

# Port the API server listens on
PORT=5000

# Comma separated list of origins allowed to call this API
# (your Vite dev server + your deployed frontend domain)
CORS_ORIGIN=http://localhost:5173

# Public base URL of this server, used to build absolute image URLs
# e.g. https://api.sic.iiti.ac.in  (no trailing slash)
PUBLIC_URL=http://localhost:5000
